{
  "name": "Scrimba-Lernen",
  "settings": "{\"settings\":\"{\\r\\n  \\\"files.autoSave\\\": \\\"afterDelay\\\",\\r\\n  \\\"files.autoSaveDelay\\\": 700,\\r\\n  \\\"livePreview.useIntegratedBrowser\\\": true,\\r\\n  \\\"livePreview.autoRefreshPreview\\\": \\\"On Changes to Saved Files\\\",\\r\\n  \\\"livePreview.openPreviewTarget\\\": \\\"Embedded Preview\\\",\\r\\n  \\\"livePreview.hostIP\\\": \\\"127.0.0.1\\\",\\r\\n  \\\"livePreview.defaultPreviewPath\\\": \\\"index.html\\\",\\r\\n  \\\"workbench.browser.newTabPlacement\\\": \\\"sideGroup\\\",\\r\\n  \\\"workbench.panel.defaultLocation\\\": \\\"bottom\\\",\\r\\n  \\\"javascript.validate.enable\\\": true\\r\\n}\"}",
  "keybindings": "{\"keybindings\":\"// F5: Scrimba im Integrated Browser rechts starten.\\n[\\n    {\\n        \\\"key\\\": \\\"f5\\\",\\n        \\\"command\\\": \\\"runCommands\\\",\\n        \\\"args\\\": {\\n            \\\"commands\\\": [\\n                \\\"workbench.action.debug.start\\\",\\n                \\\"workbench.action.moveEditorToRightGroup\\\",\\n                \\\"workbench.action.lockEditorGroup\\\",\\n                \\\"workbench.action.focusFirstEditorGroup\\\"\\n            ]\\n        },\\n        \\\"when\\\": \\\"!inDebugMode && resourcePath =~ /Scrimba/i\\\"\\n    }\\n]\\n\"}",
  "extensions": "[{\"version\":\"0.4.20\",\"identifier\":{\"id\":\"ms-vscode.live-server\"},\"displayName\":\"Live Preview\"}]"
